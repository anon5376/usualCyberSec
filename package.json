{
  "name": "usualcybersec",
  "version": "0.8.0",
  "private": true,
  "description": "Local-first incident response for suspected deepfakes, impersonation, phishing, and breaches",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:server": "python3 -m unittest tests/server_test.py",
    "serve": "python3 scripts/serve.py",
    "package:source": "python3 scripts/package.py",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.15.4",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
